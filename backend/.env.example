ENV=local
HOST=127.0.0.1
PORT=8000

# MVP development database. Tests may override this with isolated in-memory storage.
DATABASE_URL=postgresql://johnny:johnny@localhost:5432/johnny
JOHNNY_TEST_DATABASE_URL=postgresql://johnny:johnny@localhost:5432/johnny_test

# Queue and worker settings. Local development starts with in-process abstractions.
QUEUE_PROVIDER=local
AWS_REGION=ap-northeast-1

# Agent and notification integrations are optional until later MVP changes.
LLM_PROVIDER=
LLM_API_KEY=
NOTIFICATION_PROVIDER=
NOTIFICATION_API_KEY=

# Optional local-only Garmin Connect schema probe settings.
# Keep the referenced token-store file uncommitted; the database stores only credential references.
JOHNNY_GARMINCONNECT_SESSION_FILE=
JOHNNY_GARMINCONNECT_EMAIL=
JOHNNY_GARMINCONNECT_PASSWORD=
