{
  "profile": "product-admin",
  "sourceRoots": ["frontend/src"],
  "locale": "zh-TW",
  "requiredCapabilities": ["Date", "Select/Listbox", "Form", "Scrollbar"],
  "ownership": {
    "Date": "authored",
    "Select/Listbox": "native"
  },
  "requiredCommands": ["test", "build", "tokens"],
  "commands": {
    "test": "cd frontend && npm run test",
    "build": "cd frontend && npm run build",
    "tokens": "cd frontend && npm run verify:tokens"
  }
}
