# Copy to /etc/johnny/production.env on EC2. These values are public configuration.
ENV=production
AWS_REGION=ap-northeast-1
FRONTEND_URL=https://app.example.com
API_URL=https://api.example.com
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-client-id
LLM_MODEL=replace-with-approved-model
GARMIN_CREDENTIAL_KEY_ID=production-fernet
